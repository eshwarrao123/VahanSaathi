# Server Environment Variables (VahanSaathi)
# DO NOT expose OPENAI_API_KEY with NEXT_PUBLIC_ prefix — server-side only

# Required: OpenAI API key
OPENAI_API_KEY="your-openai-api-key-here"

# Required: PostgreSQL Database URL (Local & Production)
DATABASE_URL="postgresql://user:password@localhost:5432/vahansaathi?schema=public"

# Optional: Override AI model (default: gpt-4o-mini — cheapest capable model)
# OPENAI_MODEL="gpt-4o-mini"

# Optional: Override per-moment token budgets for cost control
# AI_TOKENS_INTERPRET="250"
# AI_TOKENS_EXPLAIN_ROADMAP="300"
# AI_TOKENS_EXPLAIN_STEP="250"
